rules_version = '2';

// ScriptMaker Firestore rules — 段階2（共有データの上書き防止つき）
//
// 前提: Firebaseコンソールで Authentication > Sign-in method > 「匿名」を有効にしてあること。
// Editorは共有するときに自動で匿名ログインし、共有データに作成者ID(ownerUid)を記録します。
// このルールでは、作成者本人のブラウザ以外から共有データを上書きできなくなります。
// （共有URLを知っている閲覧者が中身を書き換える、といった荒らしを防ぎます）
//
// 反映手順は SECURITY-SETUP.md を参照してください。

service cloud.firestore {
  match /databases/{database}/documents {

    function rootMetaKeys() {
      return ['id', 'title', 'data', 'chunkCount', 'schemaVersion', 'revision',
              'updatedByDeviceId', 'createdAt', 'updatedAt', 'ownerUid'];
    }

    function validRootMeta() {
      return request.resource.data.keys().hasOnly(rootMetaKeys())
        && (!('data' in request.resource.data) || (request.resource.data.data is string && request.resource.data.data.size() <= 700000))
        && (!('chunkCount' in request.resource.data) || (request.resource.data.chunkCount is int && request.resource.data.chunkCount <= 2000));
    }

    function validChunk() {
      return request.resource.data.keys().hasOnly(['index', 'data'])
        && request.resource.data.index is int
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 700000;
    }

    function signedIn() {
      return request.auth != null;
    }

    // 新しく書き込む内容の作成者が自分であること
    function writesOwnUid() {
      return signedIn() && request.resource.data.ownerUid == request.auth.uid;
    }

    // 既存データの作成者が自分であること（作成者が記録されていない古い共有は、最初に更新した人が作成者になる）
    function ownsExisting() {
      return !('ownerUid' in resource.data) || resource.data.ownerUid == request.auth.uid;
    }

    match /scriptShares/{shareId} {
      allow get: if true;
      allow list: if false;
      allow create: if validRootMeta() && writesOwnUid();
      allow update: if validRootMeta() && writesOwnUid() && ownsExisting();
      allow delete: if false;

      match /chunks/{chunkId} {
        allow read: if true;
        // 同じ書き込み（バッチ）で親ドキュメントの作成者が自分になっていること
        allow create, update: if validChunk() && signedIn()
          && getAfter(/databases/$(database)/documents/scriptShares/$(shareId)).data.ownerUid == request.auth.uid;
        allow delete: if false;
      }
    }

    match /editorProjects/{projectId} {
      allow get: if true;
      allow list: if false;
      allow create, update: if validRootMeta() && request.resource.data.id == projectId;
      allow delete: if false;

      match /chunks/{chunkId} {
        allow read: if true;
        allow create, update: if validChunk();
        allow delete: if false;
      }
    }

    match /editorRecoveryCodes/{codeHash} {
      allow get: if true;
      allow list: if false;
      allow create, update: if request.resource.data.keys().hasOnly([
        'recoveryCodeHash',
        'syncSpaceId',
        'active',
        'createdAt',
        'updatedAt',
        'disabledAt'
      ])
      && request.resource.data.recoveryCodeHash == codeHash;
      allow delete: if false;
    }

    match /editorSyncSpaces/{syncSpaceId} {
      allow get: if true;
      allow list: if false;
      allow create, update: if request.resource.data.keys().hasOnly([
        'id',
        'schemaVersion',
        'recoveryCodeHash',
        'revision',
        'updatedByDeviceId',
        'createdAt',
        'updatedAt'
      ])
      && request.resource.data.id == syncSpaceId;
      allow delete: if false;

      match /states/{stateId} {
        allow get: if true;
        allow list: if false;
        allow create, update: if validRootMeta();
        allow delete: if false;

        match /chunks/{chunkId} {
          allow read: if true;
          allow create, update: if validChunk();
          allow delete: if false;
        }
      }

      match /devices/{deviceId} {
        allow read: if true;
        allow create, update: if request.resource.data.keys().hasOnly([
          'id',
          'name',
          'deviceTokenHash',
          'isActive',
          'registeredAt',
          'lastSyncAt'
        ])
        && request.resource.data.id == deviceId;
        allow delete: if false;
      }
    }
  }
}
